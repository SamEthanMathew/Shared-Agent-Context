# The web app's build output is committed (see web/README.md) and CI verifies it
# by rebuilding and diffing. Line-ending normalisation would make that diff fail
# on any OS that checks out differently from the one that built it, so these
# files are stored byte-for-byte.
app/static/app/** -text

# The web *sources* must also check out identically everywhere, or a Windows
# working copy builds from CRLF while CI builds from LF and the diff above fails
# for no real reason. LF for everything the bundler reads.
web/** text eol=lf
web/package-lock.json text eol=lf
